# ─────────────────────────────────────────────────────────
#  SELLURA BEAUTY — BACKEND ENV EXAMPLE
#  Copy to .env and fill in your values
# ───────────────────────────────────────────────────

DATABASE_URL=postgres://selorabeauty:selorabeauty@database:5432/selorabeauty?sslmode=disable
SECRET_KEY=change-this-to-a-random-64-char-hex-string
CORS_ORIGINS=https://seloorabeauty.shop,http://localhost:3000
TIKTOK_PIXEL_ID=YOUR_TIKTOK_PIXEL_ID
TIKTOK_ACCESS_TOKEN=YOUR_TIKTOK_ACCESS_TOKEN
SNAPCHAT_PIXEL_ID=YOUR_SNAPCHAT_PIXEL_ID
SNAPCHAT_ACCESS_TOKEN=YOUR_SNAPCHAT_ACCESS_TOKEN

# ── GOOGLE SHEETS DIRECT API ──────────────────────────────
GOOGLE_SPREADSHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_SA_CLIENT_EMAIL=selora-sheet@selora-beauty.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY_ID=YOUR_PRIVATE_KEY_ID
GOOGLE_SA_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_SA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n

SINGLE_PRICE=199
COMPLETE_SET_PRICE=279
DOUBLE_SET_PRICE=389
UPSELL_PRICE=99
VAT_RATE=0.15
COD_FEE=0
